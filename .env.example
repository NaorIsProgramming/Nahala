# Copy to .env and fill in local values. Do not commit .env.
# Generate passwords as hex (alphanumeric). They can sit in a URL without encoding.

# Superuser password for the Docker image only. Application code does not read this.
POSTGRES_PASSWORD=

# Role passwords. Docker Compose passes these into the init script. The app does not read them.
NAHALA_APP_PASSWORD=
NAHALA_MIGRATOR_PASSWORD=

# App role: postgresql://nahala_app:<password>@127.0.0.1:5432/nahala
DATABASE_URL=

# Migrator role. Drizzle Kit reads this. The Next.js process does not.
# postgresql://nahala_migrator:<password>@127.0.0.1:5432/nahala
MIGRATE_DATABASE_URL=

# At least 32 characters.
BETTER_AUTH_SECRET=

# Origin of the app. Local default.
BETTER_AUTH_URL=http://localhost:3000

# Local bootstrap user for `npm run db:seed`. No default email.
# The password may be left empty to prompt. The seed never prints it.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
